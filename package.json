{
  "name": "screenmirror",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Wi-Fi screen + system audio mirroring for Fire TV and phones",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:web": "vite build",
    "build": "npm run build:main && npm run build:web",
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "coverage": "node --test --experimental-test-coverage \"tests/**/*.test.ts\"",
    "lint": "eslint . --max-warnings 0",
    "verify": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
